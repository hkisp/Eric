<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Eric agent</AssemblyName>
    <RootNamespace>IDCXray</RootNamespace>
    <Version>1.0.0</Version><AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion><InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.*" />
    <Compile Include="..\..\src\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\..\src\XrayConfig.cs" Link="Shared\XrayConfig.cs" />
    <Compile Include="..\..\src\BuiltInDefaults.cs" Link="Shared\BuiltInDefaults.cs" />
    <EmbeddedResource Include="Assets\eric-agent.ico" LogicalName="IDCXray.Assets.eric-agent.ico" />
  </ItemGroup>
</Project>
